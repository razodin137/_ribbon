{
  "manifest_version": 3,
  "name": "Ribbon Shelf",
  "version": "1.0.0",
  "description": "A shelf of your Ribbon projects on every new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://[::1]/*"
      ],
      "js": [ "home.js" ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "newtab.html" ],
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://[::1]/*"
      ]
    }
  ]
}
